# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local-only session artifacts (brainstorming, plan files generated by superpowers/mattpocock)

# local-only tests + design handoff
/tests/
/ontab_design/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (local)
.claude/settings.local.json

# editors
.vscode/
.idea/

# os
Thumbs.db
ehthumbs.db
Desktop.ini

# build caches
.turbo/
.swc/
.gstack/

# pdfjs-dist assets copied by scripts/copy-pdfjs.mjs (postinstall)
public/pdfjs/

# qpdf-wasm binary copied by scripts/copy-qpdf.mjs (postinstall)
public/qpdf/
